// MARK: - Intro
"intro.title" = "Bienvenido a KiNDD Resource Navigator";
"intro.lead" = "Esta aplicación está diseñada para ayudar a las familias a encontrar servicios y terapias del desarrollo para sus hijos en todo el condado de Los Ángeles.";
"intro.howItWorks.heading" = "¿Cómo funciona?";
"intro.howItWorks.body" = "Le haremos algunas preguntas sobre las necesidades, la edad y la ubicación de su hijo para ayudarle a encontrar servicios y recursos relevantes en su área.";
"intro.services.heading" = "¿Qué servicios puedo encontrar?";
"intro.services.body" = "El navegador de recursos puede ayudarle a explorar servicios como el análisis aplicado de la conducta (ABA), la terapia ocupacional (OT), la fisioterapia (PT), la terapia del habla y lenguaje (SLP) y otros servicios del desarrollo.";
"intro.audience.heading" = "¿Quién puede usar esta aplicación?";
"intro.audience.body" = "Esta herramienta está pensada para apoyar a familias, cuidadores y profesionales clínicos de niños con discapacidades del neurodesarrollo o inquietudes sobre su desarrollo que buscan servicios y apoyo.";
"intro.afterQuestions.heading" = "¿Qué pasa después de responder las preguntas?";
"intro.afterQuestions.body" = "Según sus respuestas, la aplicación le ayudará a identificar proveedores y servicios que podrían ser relevantes. Puede usar esta información para explorar sus opciones y comunicarse directamente con los proveedores para conocer sus servicios, disponibilidad y requisitos de elegibilidad.";
"intro.privacy.heading" = "Su privacidad";
"intro.privacy.body" = "Sus respuestas a estas preguntas se guardan en su dispositivo para que KiNDD recuerde sus preferencias. Su código postal o ubicación se envía a KiNDD solo para encontrar servicios cerca de usted, y no guardamos un historial de sus búsquedas vinculado a usted. KiNDD no requiere una cuenta y no vendemos su información. Si usa Pregúntale a KiNDD, su pregunta y estas respuestas se envían para ayudar a responderla. Consulte nuestra Política de privacidad para más detalles.";
"intro.privacyLinkLabel" = "Política de privacidad";
"intro.language.heading" = "Idioma y accesibilidad";
"intro.language.body" = "KiNDD está disponible en inglés y español. Puede cambiar el idioma en cualquier momento en Configuración. KiNDD respeta el tamaño de texto y la configuración de VoiceOver de su iPhone. Si necesita ayuda para usar KiNDD, escriba a support@kinddhelp.org.";
"intro.keepInMind.heading" = "Tenga en cuenta";
"intro.keepInMind.body" = "KiNDD Resource Navigator es una herramienta informativa y no sustituye una consulta médica ni el consejo de un profesional. No ofrece diagnósticos ni recomendaciones médicas oficiales. Consulte a un proveedor de atención médica con licencia al tomar decisiones sobre el cuidado de su hijo.";
"intro.providers.heading" = "Sobre los proveedores de servicios";
"intro.providers.body" = "El equipo de KiNDD trabaja para mantener un directorio preciso y útil de proveedores de servicios del desarrollo. Sin embargo, los servicios, la disponibilidad, los requisitos de elegibilidad y la información de los proveedores pueden cambiar. Que un proveedor aparezca en la aplicación no constituye un respaldo ni una garantía de sus servicios o de la calidad de su atención.";
"intro.urgent.heading" = "Inquietudes urgentes";
"intro.urgent.body" = "KiNDD Resource Navigator no está pensado para emergencias ni inquietudes médicas urgentes. Si su hijo tiene una emergencia médica, llame al 911 o acuda a la sala de emergencias del hospital más cercano.";
"intro.help.heading" = "Estamos aquí para ayudar";
"intro.help.body" = "Encontrar servicios del desarrollo puede ser abrumador, y esperamos que esta herramienta le facilite explorar sus opciones y conectarse con recursos que apoyen a su hijo y a su familia. Escriba a support@kinddhelp.org si tiene preguntas o inquietudes.";
"intro.done" = "Listo";
"intro.settingsLabel" = "Guía de bienvenida";

