// MARK: - Intro
"intro.title" = "Welcome to the KiNDD Resource Navigator";
"intro.lead" = "This application is designed to help families find developmental services and therapies for their children throughout Los Angeles County.";
"intro.howItWorks.heading" = "How does it work?";
"intro.howItWorks.body" = "You will be asked a few questions about your child's needs, age, and location to help identify relevant services and resources in your area.";
"intro.services.heading" = "What services can I find?";
"intro.services.body" = "The Resource Navigator can help you explore services such as Applied Behavior Analysis (ABA), occupational therapy (OT), physical therapy (PT), speech-language therapy (SLP), and other developmental services.";
"intro.audience.heading" = "Who can use this application?";
"intro.audience.body" = "This tool is intended to support families, caregivers, and clinicians of children with neurodevelopmental disabilities or developmental concerns who are looking for services and support.";
"intro.afterQuestions.heading" = "What happens after I answer the questions?";
"intro.afterQuestions.body" = "Based on your responses, the application will help you identify potentially relevant providers and services. You can use this information to explore your options and contact providers directly to learn more about their services, availability, and eligibility requirements.";
"intro.privacy.heading" = "Your privacy";
"intro.privacy.body" = "Your answers to these questions are saved on your device so KiNDD can remember your preferences. Your ZIP code or location is sent to KiNDD only to find services near you, and we don't keep a history of your searches tied to you. KiNDD doesn't require an account, and we don't sell your information. If you use Ask KiNDD, your question and these answers are sent to help answer it. See our Privacy Policy for details.";
"intro.privacyLinkLabel" = "Privacy Policy";
"intro.language.heading" = "Language and accessibility";
"intro.language.body" = "KiNDD is available in English and Spanish. You can change the language at any time in Settings. KiNDD follows your iPhone's text size and VoiceOver settings. If you need help using KiNDD, email support@kinddhelp.org.";
"intro.keepInMind.heading" = "Please keep in mind";
"intro.keepInMind.body" = "The KiNDD Resource Navigator is an informational tool, not a substitute for medical consultation or professional advice. It does not provide diagnoses or official medical recommendations. Please consult a licensed healthcare provider when making decisions about your child's care.";
"intro.providers.heading" = "About service providers";
"intro.providers.body" = "The KiNDD team works to maintain an accurate and useful directory of developmental service providers. However, services, availability, eligibility requirements, and provider information may change. Inclusion in the application does not constitute an endorsement or guarantee of a provider's services or quality of care.";
"intro.urgent.heading" = "Urgent concerns";
"intro.urgent.body" = "The KiNDD Resource Navigator is not intended for emergencies or urgent medical concerns. If your child is experiencing a medical emergency, please call 911 or go to your nearest hospital's Emergency Department.";
"intro.help.heading" = "We're here to help";
"intro.help.body" = "Finding developmental services can feel overwhelming, and we hope this tool makes it easier to explore your options and connect with resources that support your child and family. Please contact support@kinddhelp.org with any questions or concerns.";
"intro.done" = "Done";
"intro.settingsLabel" = "Welcome guide";

